# ========================
# POSTLEE SERVER CONFIG
# ========================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postlee:SUA_SENHA_AQUI@localhost:5432/postlee

# JWT
JWT_SECRET=TROQUE_POR_UMA_CHAVE_SECRETA_LONGA_ALEATORIA
JWT_REFRESH_SECRET=TROQUE_POR_OUTRA_CHAVE_SECRETA
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider (configure quando decidir)
# Opções: openai, gemini, anthropic, local
AI_PROVIDER=openai
AI_API_KEY=COLOQUE_SUA_CHAVE_AQUI
AI_MODEL=gpt-4o

# Meta / Instagram (configure no Meta for Developers)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3001/api/auth/meta/callback

# Storage (caminho local na VPS)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AutoFeed
AUTOFEED_ENABLED=true
AUTOFEED_CHECK_INTERVAL=*/15 * * * *

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173
